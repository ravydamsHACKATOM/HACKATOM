{
  "name": "studyflow-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Static front-end of StudyFlow. No build step: these scripts only lint, format and test.",
  "type": "module",
  "scripts": {
    "lint": "eslint js tests && prettier --check \"js/**/*.js\" \"tests/**/*.js\" \"styles/**/*.css\" index.html",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"styles/**/*.css\" index.html",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
