# Variable names read by the back-end. Export the ones you need before starting it.
# Real values never go in the repository.
# Every value is optional: without them StudyFlow runs with its defaults.

# Enables the AI advisor. Without a key the app uses the rule-based advisor.
ANTHROPIC_API_KEY=

# Model used by the AI advisor.
STUDYFLOW_AI_MODEL=claude-opus-5-5

# SQLite database file.
STUDYFLOW_DB=./data/studyflow.db

# Time zone that defines "today" for the student.
STUDYFLOW_ZONE=America/Sao_Paulo

# HTTP port.
PORT=8080
